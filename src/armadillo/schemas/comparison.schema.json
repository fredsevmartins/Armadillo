                    ],
                    "properties": {
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      },
                      "predicate": {
                        "type": "string",
                        "minLength": 1
                      },
                      "object": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "uniqueItems": true
                },
                "derivations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "conclusion",
