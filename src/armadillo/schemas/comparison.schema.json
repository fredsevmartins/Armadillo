      },
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "Armadillo report schema"
    },
    "limitations": {
      "type": "string"
    },
    "tamandua_impact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "identity_policy",
        "baseline_rdf_sha256",
        "proposed_rdf_sha256",
        "analytical"
      ],
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "identity_policy": {
          "const": "document-sha256-and-node-id"
        },
        "baseline_rdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "proposed_rdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analytical": {
          "type": "object",
          "required": [
            "engine_version",
            "graph_id",
            "changes",
            "impact",
            "proposed_assertions",
            "proposed_inferences",
            "explanations",
            "invalidated_explanations"
          ],
          "properties": {
            "engine_version": {
              "const": "0.1.0"
            },
            "graph_id": {
              "type": "string"
            },
            "changes": {
              "type": "object"
            },
            "impact": {
              "type": "object"
            },
            "proposed_assertions": {
              "type": "array"
            },
            "proposed_inferences": {
              "type": "array"
            },
            "explanations": {
              "type": "array"
            },
            "invalidated_explanations": {
              "type": "array"
            }
          }
        }
      }
    },
    "claim_support_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "lost_supporters",
          "gained_supporters",
          "quote_found_before",
          "quote_found_after"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "lost_supporters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gained_supporters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "quote_found_before": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "quote_found_after": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
