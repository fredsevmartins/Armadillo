                    }
                  }
                }
              },
              "occurrences_truncated": {
                "type": "boolean"
              },
              "source_present_supporters": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "limitations": {
          "type": "string"
        },
        "tamandua": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "contract_version",
            "engine",
            "rdf_sha256",
            "analytical"
          ],
          "properties": {
            "contract_version": {
              "const": "1.1"
            },
            "engine": {
              "enum": [
                "dominox 0.1.0",
                "tamandua 0.1.0"
              ]
            },
            "rdf_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "analytical": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asserted",
                "inferred",
