                    ],
                    "properties": {
                      "conclusion": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "subject",
                          "predicate",
                          "object"
                        ],
                        "properties": {
                          "subject": {
                            "type": "string",
                            "minLength": 1
                          },
                          "predicate": {
                            "type": "string",
                            "minLength": 1
                          },
                          "object": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
