{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "engine",
    "rdf_sha256",
    "analytical"
  ],
  "properties": {
    "contract_version": {
      "const": "1.1"
    },
    "engine": {
      "enum": [
        "dominox 0.1.0",
        "tamandua 0.1.0"
      ]
    },
    "rdf_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "analytical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asserted",
        "inferred",
        "derivations"
      ],
      "properties": {
        "asserted": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "predicate",
              "object"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uniqueItems": true
        },
        "inferred": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "subject",
              "predicate",
              "object"
            ],
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "predicate": {
                "type": "string",
                "minLength": 1
              },
              "object": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "uniqueItems": true
        },
        "derivations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "conclusion",
              "alternatives"
            ],
            "properties": {
              "conclusion": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "predicate",
                  "object"
                ],
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "predicate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "alternatives": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule",
                    "premises"
                  ],
                  "properties": {
                    "rule": {
                      "enum": [
                        "subclass-transitivity",
                        "subproperty-transitivity",
                        "class-membership",
                        "property-propagation",
                        "domain",
                        "range"
                      ]
                    },
                    "premises": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 2,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "subject",
                          "predicate",
                          "object"
                        ],
                        "properties": {
                          "subject": {
                            "type": "string",
                            "minLength": 1
                          },
                          "predicate": {
                            "type": "string",
                            "minLength": 1
                          },
                          "object": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Armadillo adapter schema"
}
