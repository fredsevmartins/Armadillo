{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "software_version",
    "input_sha256",
    "document_sha256",
    "status",
    "counts",
    "unsupported_claims",
    "findings",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "software_version": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "document_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "SOURCE_LINKED",
        "REVIEW_REQUIRED"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "claims",
        "missing_quotes"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "claims": {
          "type": "integer",
          "minimum": 0
        },
        "missing_quotes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "unsupported_claims": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "quote_found",
          "quote",
          "occurrences",
          "occurrences_truncated"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "claim",
              "evidence"
            ]
          },
          "quote_found": {
            "type": "boolean"
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "occurrences": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "line",
                "column",
                "context"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "column": {
                  "type": "integer",
                  "minimum": 1
                },
                "context": {
                  "type": "string",
                  "maxLength": 160
                }
              }
            }
          },
          "occurrences_truncated": {
            "type": "boolean"
          },
          "source_present_supporters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "string"
    },
    "tamandua": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "engine",
        "rdf_sha256",
        "analytical"
      ],
      "properties": {
        "contract_version": {
          "const": "1.1"
        },
        "engine": {
          "enum": [
            "dominox 0.1.0",
            "tamandua 0.1.0"
          ]
        },
        "rdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "analytical": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "asserted",
            "inferred",
            "derivations"
          ],
          "properties": {
            "asserted": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "predicate",
                  "object"
                ],
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "predicate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "uniqueItems": true
            },
            "inferred": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "subject",
                  "predicate",
                  "object"
                ],
                "properties": {
                  "subject": {
                    "type": "string",
                    "minLength": 1
                  },
                  "predicate": {
                    "type": "string",
                    "minLength": 1
                  },
                  "object": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "uniqueItems": true
            },
            "derivations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "conclusion",
                  "alternatives"
                ],
                "properties": {
                  "conclusion": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "subject",
                      "predicate",
                      "object"
                    ],
                    "properties": {
                      "subject": {
                        "type": "string",
                        "minLength": 1
                      },
                      "predicate": {
                        "type": "string",
                        "minLength": 1
                      },
                      "object": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "alternatives": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "rule",
                        "premises"
                      ],
                      "properties": {
                        "rule": {
                          "enum": [
                            "subclass-transitivity",
                            "subproperty-transitivity",
                            "class-membership",
                            "property-propagation",
                            "domain",
                            "range"
                          ]
                        },
                        "premises": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 2,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "subject",
                              "predicate",
                              "object"
                            ],
                            "properties": {
                              "subject": {
                                "type": "string",
                                "minLength": 1
                              },
                              "predicate": {
                                "type": "string",
                                "minLength": 1
                              },
                              "object": {
                                "type": "string",
                                "minLength": 1
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Armadillo report schema"
}
